# Input
INPUT_PATH=./data/in/source.geojson
INPUT_LAYER=
INPUT_CRS=

# Transform
TARGET_CRS=4326
CLIP_BBOX=
REQUIRE_VALID_GEOM=true
SIMPLIFY_TOLERANCE=

# Output
OUTPUT_DIR=./data/out
OUTPUT_NAME=my_dataset
PARTITION_COLUMN=

# Optional PostGIS
PG_DSN=postgresql+psycopg2://user:pass@localhost:5432/gis
PG_SCHEMA=public
PG_TABLE=my_dataset
PG_IF_EXISTS=replace

# Pipeline
RUN_ID=
MAX_ROWS=
